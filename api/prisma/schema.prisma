generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(CASHIER)
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  Int?
  products     Product[]     @relation("AdminProducts")
  shifts       Shift[]
  transactions Transaction[]
  createdBy    User?         @relation("AdminCashiers", fields: [createdById], references: [id])
  cashiers     User[]        @relation("AdminCashiers")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          Int               @id @default(autoincrement())
  categoryId  Int
  name        String
  price       Decimal           @db.Decimal(12, 2)
  stock       Int               @default(0)
  image       String?
  isDeleted   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById Int
  category    Category          @relation(fields: [categoryId], references: [id])
  createdBy   User              @relation("AdminProducts", fields: [createdById], references: [id])
  items       TransactionItem[]
}

model Shift {
  id             Int           @id @default(autoincrement())
  cashierId      Int
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  initialCash    Decimal       @db.Decimal(12, 2)
  finalCash      Decimal?      @db.Decimal(12, 2)
  expectedCash   Decimal?      @db.Decimal(12, 2)
  cashDifference Decimal?      @db.Decimal(12, 2)
  status         ShiftStatus   @default(OPEN)
  cashier        User          @relation(fields: [cashierId], references: [id])
  transactions   Transaction[]
}

model Transaction {
  id            Int               @id @default(autoincrement())
  shiftId       Int
  cashierId     Int
  totalAmount   Decimal           @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  cashReceived  Decimal?          @db.Decimal(12, 2)
  changeAmount  Decimal?          @db.Decimal(12, 2)
  cardLastFour  String?
  createdAt     DateTime          @default(now())
  cashier       User              @relation(fields: [cashierId], references: [id])
  shift         Shift             @relation(fields: [shiftId], references: [id])
  items         TransactionItem[]
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  productId     Int
  quantity      Int
  price         Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)
  product       Product     @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

enum Role {
  ADMIN
  CASHIER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  DEBIT
}
